#!/usr/bin/env bash
# Terminal player for the ASCII "brain" animation from
# https://github.com/that-ponderer/ZAPP (config/sharpshell/animations/brain)
# Colors replicated from the original GTK widget (style.css + config.json):
# fg @COL8 #6c7086 on bg @COL0 #1e1e2e (Catppuccin Mocha).
#
# Usage: brain [-f FPS] [-d DIR] [-r] [-C FG] [-p] [-h]
#   -f FPS       frames per second (default: 30)
#   -d DIR       directory with frames (default: ~/.local/share/brain-anim)
#   -r           reverse playback direction
#   -C FG        truecolor hex, e.g. brain -C "#f38ba8"
#                (default: "#6c7086" — @COL8 из ZAPP)
#   -p           plain mode: default terminal colors
#   -h           show this help

set -euo pipefail

FPS=30
FRAME_DIR="${BRAIN_ANIM_DIR:-$HOME/.local/share/brain-anim}"
REVERSE=0
PLAIN=0
FG_HEX='#6c7086'

usage() {
    sed -n 's/^# \(  Usage:\)/\1/p; s/^#   //p' "${BASH_SOURCE[0]}"
    exit 0
}

hex_to_ansi() {
    # "#6c7086" -> "108;112;134"; returns non-zero on malformed input
    local h="$1" r g b
    [[ "$h" =~ ^#?[0-9a-fA-F]{6}$ ]] || return 1
    h=${h#\#}
    r=$(( 16#${h:0:2} ))
    g=$(( 16#${h:2:2} ))
    b=$(( 16#${h:4:2} ))
    printf '%s;%s;%s' "$r" "$g" "$b"
}

while getopts "f:d:C:prh" opt; do
    case "$opt" in
        f) FPS="$OPTARG" ;;
        d) FRAME_DIR="$OPTARG" ;;
        C) FG_HEX="$OPTARG" ;;
        p) PLAIN=1 ;;
        r) REVERSE=1 ;;
        h) usage ;;
        *) usage ;;
    esac
done

FG_ANSI=$(hex_to_ansi "$FG_HEX") || { echo "brain: bad fg color '$FG_HEX'" >&2; exit 1; }

frames=("$FRAME_DIR"/0*)
[[ ${#frames[@]} -gt 0 ]] || { echo "brain: no frames found in $FRAME_DIR" >&2; exit 1; }
n=${#frames[@]}
(( FPS >= 1 )) || FPS=1

restore() {
    printf '\e[?25h\e[0m\e[?1049l'
}
trap restore EXIT
trap 'exit' INT TERM

# Init: alt screen (keeps scrollback clean), hide cursor, clear to the
# terminal's own background — background NOT painted (user's choice)
printf '\e[?1049h\e[?25l\e[2J\e[H'
if (( ! PLAIN )); then
    fg_seq=$'\e[38;2;'"${FG_ANSI}"'m'
else
    fg_seq=''
fi

sleep_ms() {
    local ms="$1"
    if (( ms >= 1000 )); then
        sleep "$(( ms / 1000 )).$(printf '%03d' $(( ms % 1000 )))"
    else
        sleep "0.$(printf '%03d' "$ms")"
    fi
}

# EPOCHREALTIME = "sec.micro" (decimal sep depends on locale) -> integer us
t0=${EPOCHREALTIME//[.,]/}
k=0

while :; do
    target=$(( t0 + (k * 1000000) / FPS ))
    now=${EPOCHREALTIME//[.,]/}
    wait_us=$(( target - now ))
    if (( wait_us > 1000 )); then
        sleep_ms $(( wait_us / 1000 ))
    fi

    if (( REVERSE )); then
        idx=$(( n - 1 - k % n ))
    else
        idx=$(( k % n ))
    fi

    # re-assert fg before every frame: some terminals reset SGR on
    # alt-screen switches/clears, and this costs nothing
    printf '\e[H%s' "$fg_seq"
    cat "${frames[idx]}"
    k=$(( k + 1 ))
done
